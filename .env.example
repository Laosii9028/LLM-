# 複製這個檔為 .env(本地測試用),或把這三個值設成 GitHub Secrets(自動排程用)。

# Alpha Vantage 免費金鑰: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_key_here

# Google Gemini 免費金鑰: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# 可選: 模型設定。留空時使用預設:
# 主早報分析: gemini-3.6-flash
# 關聯抽取: gemini-3.5-flash-lite
# GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
# GEMINI_LEARNED_MODEL=gemini-3.5-flash-lite

# Discord 頻道 → 設定 → 整合 → Webhook → 建立 → 複製 Webhook URL
DISCORD_WEBHOOK_URL=your_webhook_url_here
